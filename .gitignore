```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Environment variables
.env
.env.local
*.env.*

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# Coverage reports
coverage/
htmlcov/
.coverage

# Python artifacts (if any Python in project)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Distribution / packaging
*.tar.gz
*.whl
*.egg-info/

# OS generated files
.DS_Store
Thumbs.db
```