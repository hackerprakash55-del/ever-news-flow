```gitignore
# Dependencies
node_modules/
.pnpm-store/
.npm/
.yarn/

# Build outputs
dist/
build/
.next/
.nuxt/
public/build/
*.min.js
*.min.css

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*
!.env.example

# IDE specific
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Python specific (if applicable)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/
.pytype/

# Coverage reports
coverage/
*.lcov

# Local configuration
local.properties
.settings/
*.tmproj
nbproject/

# Compiled and binary files
*.exe
*.dll
*.so
*.dylib
*.class
*.o
*.a
*.obj
*.out

# Compressed files
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.7z
*.rar
*.gz
*.bz2
*.xz
*.zst

# Testing
coverage.xml
*.gcda
*.gcno

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
```